pipeline{
 agent any{

stages {


stage('Continuous Integration (Build)') {
            steps {
                // 1. Clone the repository into the workspace
                git branch: 'main', url: 'https://github.com/AbhishekTerraform28/Jenkins_Github_Integration.git'
                
                // 2. Build the Docker image
                sh 'docker build -t my-web-image:latest .'
            }
        }

stage (checkout from code repository){
    steps{
        echo 'checkout from code'
        checkout scm
    }
}

stage (build){
    steps{
        echo 'builidng the code in our workspace'
        
            }
}


stage(test){
    steps{
echo 'test the app'         
    }
}


 stage('Continuous Delivery (Approval Gate)') {
            steps {
                // Pipeline pauses here waiting for manual approval
                input message: 'Do you want to deploy this build to Production?', ok: 'Deploy'
            }
        }


    stage('Deploy to Production') {
            steps {
                // Runs only after "Deploy" is clicked
                sh '''
                    docker stop my-web-app || true
                    docker rm my-web-app || true
                    docker run -d --name my-web-app -p 8081:80 my-web-image:latest
                '''
            }
        }

post{
    success {
        echo 'pipline deployment success'
    }


    failure {
        echo 'deployemnt failed'
    }
}


}
 }
}
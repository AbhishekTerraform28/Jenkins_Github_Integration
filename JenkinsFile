pipeline{
    agent any

stages{

stage('checkout'){
    steps{
        echo 'checkout from code'
        checkout scm
    }
}

stage('test'){
    steps{
        echo 'test from code'
        //checkout scm
    }
}

stage('build'){
    steps {
                echo 'Building Docker image in workspace'
                sh 'docker build -t my-web-image:latest .'
            }
}

stage('Continuous Delivery (Approval Gate)') {
            steps {
                input message: 'Do you want to deploy this build to Production?', ok: 'Deploy'
            }
        }
 
stage('deploy'){
    steps {
                sh '''
                    docker stop my-web-app || true
                    docker rm my-web-app || true
                    docker run -d --name my-web-app -p 8081:80 my-web-image:latest
                '''
            }
}


}

post{
    success {
        echo 'success deployment done'
    }

    failure {
        echo 'failed at deployment'
    }
}

}